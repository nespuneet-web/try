rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidAdditionEntry(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.firstNumber is number &&
             data.secondNumber is number &&
             data.total is number &&
             data.note is string &&
             data.note.size() <= 80;
    }

    match /users/{userId}/additions/{additionId} {
      allow get: if isOwner(userId) && isValidId(additionId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(additionId) &&
                       incoming().keys().hasAll(['userId', 'firstNumber', 'secondNumber', 'total', 'note', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'firstNumber', 'secondNumber', 'total', 'note', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidAdditionEntry(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(additionId) &&
                       isValidAdditionEntry(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['firstNumber', 'secondNumber', 'total', 'note', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(additionId);
    }
  }
}
